# Backend — copy to server/.env (or project root .env) and fill in values

PORT=5000

# Required
RAPIDAPI_KEY=
OPENAI_API_KEY=
FIREBASE_API_KEY=

# Optional — email when user saves a job (Brevo recommended)
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=JobRecommender
BREVO_SMTP_LOGIN=

# Optional — alternative email providers
# SENDGRID_API_KEY=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# Optional — n8n multi-agent workflow
# N8N_WEBHOOK_URL=https://your-n8n.app/webhook/...
