# Node.js Backend Server Config
PORT=5000

# n8n Webhook URL — import n8n-job-recommender-workflow.json, activate workflow, then use:
# Local:  http://localhost:5678/webhook/job-recommender-webhook
# Cloud:  https://your-instance.app.n8n.cloud/webhook/job-recommender-webhook
# Set RAPIDAPI_KEY in n8n Settings → Variables (or environment) for the workflow HTTP node.
N8N_WEBHOOK_URL=http://localhost:5678/webhook/job-recommender-webhook

# RapidAPI JSearch Key (Get your free key from https://rapidapi.com/letscrape-6bb852d2-e698-472d-a94f-a496b8e3ea7e/api/jsearch)
RAPIDAPI_KEY=your_rapidapi_key_here

# OpenAI API Key for AI Resume Parsing & Match Scoring (Get key from https://platform.openai.com)
OPENAI_API_KEY=your_openai_api_key_here
