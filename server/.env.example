# Node.js Backend Server Config
PORT=5000

# n8n Webhook URL — import n8n-job-recommender-workflow.json, activate workflow, then use:
# Local:  http://localhost:5678/webhook/job-recommender-webhook
# Cloud:  https://your-instance.app.n8n.cloud/webhook/job-recommender-webhook
# Set RAPIDAPI_KEY in n8n Settings → Variables (or environment) for the workflow HTTP node.
N8N_WEBHOOK_URL=http://localhost:5678/webhook/job-recommender-webhook

# RapidAPI JSearch Key (Get your free key from https://rapidapi.com/letscrape-6bb852d2-e698-472d-a94f-a496b8e3ea7e/api/jsearch)
RAPIDAPI_KEY=your_rapidapi_key_here

# OpenAI API Key for AI Resume Parsing & Match Scoring (Get key from https://platform.openai.com)
OPENAI_API_KEY=your_openai_api_key_here

# Backend — saved-job confirmation emails (also add in Vercel)
FIREBASE_API_KEY=your_firebase_api_key

# Option A — Brevo (recommended free, 300 emails/day, no Gmail app password)
# 1. Sign up: https://www.brevo.com
# 2. Senders → Add insaaf1617@gmail.com → verify via email link
# 3. SMTP & API → API Keys → Generate
BREVO_API_KEY=your_brevo_api_key_here
EMAIL_FROM=insaaf1617@gmail.com
EMAIL_FROM_NAME=JobMatch

# Option B — SendGrid
# SENDGRID_API_KEY=your_sendgrid_api_key_here

# Option C — Gmail SMTP (requires app password)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=insaaf1617@gmail.com
# SMTP_PASS=your_gmail_app_password_here
# SMTP_FROM=insaaf1617@gmail.com
# SMTP_FROM_NAME=JobMatch
